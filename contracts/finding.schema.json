{
  "$defs": {
    "DetectorRef": {
      "additionalProperties": false,
      "description": "Who produced this. The pipeline fills it. Detectors do not.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "owner"
      ],
      "title": "DetectorRef",
      "type": "object"
    },
    "Escalation": {
      "additionalProperties": false,
      "description": "Written by the linker only. Records what the severity was before.",
      "properties": {
        "escalated": {
          "title": "Escalated",
          "type": "boolean"
        },
        "severity_before": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Severity Before",
          "type": "number"
        },
        "linked_to": {
          "items": {
            "type": "string"
          },
          "title": "Linked To",
          "type": "array"
        },
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        }
      },
      "required": [
        "escalated",
        "severity_before",
        "method"
      ],
      "title": "Escalation",
      "type": "object"
    },
    "LinkHints": {
      "additionalProperties": false,
      "description": "Evidence the cross-asset linker reads. Not a verdict.\n\nData findings tagged `patch_trigger` or `blend_trigger` carry this.\nModel findings tagged `trigger_sweep_hit` or `trigger_reconstructed` carry it.",
      "properties": {
        "target_class": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Class"
        },
        "source_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "trigger": {
          "$ref": "#/$defs/TriggerHint"
        },
        "location_bbox": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location Bbox"
        },
        "patch_template_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Patch Template Path"
        }
      },
      "required": [
        "trigger"
      ],
      "title": "LinkHints",
      "type": "object"
    },
    "PolicyRef": {
      "additionalProperties": false,
      "description": "Which rule decided the disposition. Written by the policy engine only.",
      "properties": {
        "rule_id": {
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "policy_hash": {
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Hash",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "policy_hash"
      ],
      "title": "PolicyRef",
      "type": "object"
    },
    "TriggerHint": {
      "additionalProperties": false,
      "description": "Which visual trigger a finding is about.\n\n``patch_library`` hints carry a ``patch_id`` from a known patch set.\n``reconstructed`` hints carry a mask, and optionally a pattern image.",
      "properties": {
        "kind": {
          "enum": [
            "patch_library",
            "reconstructed"
          ],
          "title": "Kind",
          "type": "string"
        },
        "patch_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Patch Id"
        },
        "mask_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mask Path"
        },
        "pattern_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pattern Path"
        }
      },
      "required": [
        "kind"
      ],
      "title": "TriggerHint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One assurance flag. Detector-proposed fields are filled by the pipeline.",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^F-\\d{3,}$"
    },
    "asset": {
      "enum": [
        "data",
        "model",
        "records",
        "shift",
        "system"
      ],
      "title": "Asset",
      "type": "string"
    },
    "reason": {
      "maxLength": 300,
      "minLength": 10,
      "title": "Reason",
      "type": "string"
    },
    "evidence": {
      "items": {
        "type": "string"
      },
      "title": "Evidence",
      "type": "array"
    },
    "severity": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Severity",
      "type": "number"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "access_level": {
      "enum": [
        "white-box",
        "gray-box",
        "black-box",
        "not-applicable"
      ],
      "title": "Access Level",
      "type": "string"
    },
    "limitations": {
      "minLength": 10,
      "title": "Limitations",
      "type": "string"
    },
    "disposition": {
      "enum": [
        "accept",
        "review",
        "quarantine",
        "rejected"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "linked_findings": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "title": "Linked Findings",
      "type": "array"
    },
    "detector": {
      "anyOf": [
        {
          "$ref": "#/$defs/DetectorRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "source_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Id"
    },
    "batch_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Batch Id"
    },
    "class_label": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Class Label"
    },
    "sample_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "title": "Sample Ids",
      "type": "array"
    },
    "sample_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sample Count"
    },
    "tags": {
      "items": {
        "enum": [
          "patch_trigger",
          "blend_trigger",
          "label_flip",
          "near_duplicate",
          "ood",
          "fingerprint_mismatch",
          "weight_digest_mismatch",
          "trigger_sweep_hit",
          "trigger_reconstructed",
          "verification_failed",
          "replay",
          "substitution",
          "drift",
          "manipulation",
          "undetermined",
          "skipped_access_tier"
        ],
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "link_hints": {
      "anyOf": [
        {
          "$ref": "#/$defs/LinkHints"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "escalation": {
      "anyOf": [
        {
          "$ref": "#/$defs/Escalation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/PolicyRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "stub": {
      "default": false,
      "title": "Stub",
      "type": "boolean"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "id",
    "asset",
    "reason",
    "evidence",
    "severity",
    "confidence",
    "access_level",
    "limitations",
    "disposition",
    "linked_findings"
  ],
  "title": "CVAssure Finding",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cvassure.local/contracts/finding.schema.json"
}
